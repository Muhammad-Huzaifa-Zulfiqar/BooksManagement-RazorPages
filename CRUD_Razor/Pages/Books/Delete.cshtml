@page "{id:int}"
@model CRUD_Razor.DeleteModel
@{
    ViewData["Title"] = "Delete Book";
}

<div class="page-head">
    <div>
        <h2>Delete Book</h2>
        <p class="sub">Please review before confirming.</p>
    </div>
</div>

<div class="card-panel form-card">
    <div class="danger-banner">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <strong>Are you sure you want to delete this book?</strong><br />
            This action cannot be undone.
        </div>
    </div>

    <dl class="row detail-list mb-4">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Book.title</dd>

        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">@Model.Book.author</dd>

        <dt class="col-sm-3">Publisher</dt>
        <dd class="col-sm-9">@Model.Book.publisher</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Book.category</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><partial name="_StatusBadge" model="Model.Book.status" /></dd>
    </dl>

    <form method="post" asp-route-id="@Model.Book.Id" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash3-fill me-1"></i>Confirm Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
