@page
@model CRUD_Razor.IndexModel
@{
    ViewData["Title"] = "Books";
}

<div class="page-head">
    <div>
        <h2>Books</h2>
        <p class="sub"><span id="visibleCount">@Model.Books.Count</span> of @Model.Books.Count books shown</p>
    </div>
    <a asp-page="Create" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i>Add New Book</a>
</div>

<div class="card-panel">
    <div class="toolbar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input id="bookSearch" type="search" class="form-control" placeholder="Search by title, author, publisher..." />
        </div>
    </div>

    @if (Model.Books.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <h5 class="mt-3">No books yet</h5>
            <p>Add your first book to get started.</p>
            <a asp-page="Create" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i>Add New Book</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table books-table align-middle" id="booksTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Book</th>
                        <th>Publisher</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td class="id-pill">@book.Id</td>
                            <td>
                                <div class="book-title">@book.title</div>
                                <div class="book-desc">
                                    by @(string.IsNullOrWhiteSpace(book.author) ? "Unknown" : book.author)
                                    @if (!string.IsNullOrWhiteSpace(book.description))
                                    {
                                        <span> &middot; @book.description</span>
                                    }
                                </div>
                            </td>
                            <td>@book.publisher</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(book.category))
                                {
                                    <span class="chip">@book.category</span>
                                }
                            </td>
                            <td><partial name="_StatusBadge" model="book.status" /></td>
                            <td class="text-end text-nowrap">
                                <a asp-page="Edit" asp-route-id="@book.Id" class="btn btn-icon btn-soft-edit" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@book.Id" class="btn btn-icon btn-soft-del" title="Delete">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="noMatch" class="empty-state d-none">
            <i class="bi bi-search"></i>
            <p class="mt-2 mb-0">No books match your search.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById('bookSearch');
            var table = document.getElementById('booksTable');
            if (!box || !table) return;
            var rows = table.querySelectorAll('tbody tr');
            var count = document.getElementById('visibleCount');
            var noMatch = document.getElementById('noMatch');
            box.addEventListener('input', function () {
                var q = box.value.trim().toLowerCase();
                var shown = 0;
                rows.forEach(function (r) {
                    var match = r.innerText.toLowerCase().indexOf(q) !== -1;
                    r.style.display = match ? '' : 'none';
                    if (match) shown++;
                });
                count.textContent = shown;
                noMatch.classList.toggle('d-none', shown !== 0);
            });
        })();
    </script>
}
